# ==============================================================================
# YATRA Platform — Environment Configuration Template (.env.example)
# Copy this file to `.env` in the root directory and populate appropriate values.
# ==============================================================================

# Application Environment ('development' | 'production' | 'staging')
APP_ENV=development

# JWT Authentication Secrets (Generate secure random 64-char hex strings in production)
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# Google OAuth Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=

# MySQL Database Connection Settings (Enterprise DB & virtual view schemas)
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_SSL=false

# SMTP Email Service (Used for delivering OTP verification codes)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# Google Gemini AI Integration (Itinerary & AI Assistant generation)
# Obtain free API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Frontend Base URLs (Optional overrides for Vite dev server / production build)
VITE_AGENCY_API_BASE=http://localhost:8000
VITE_TRAVELLER_API_BASE=http://localhost:8001
VITE_ADMIN_API_BASE=http://localhost:8002
VITE_AUTH_API_BASE=http://localhost:8003
